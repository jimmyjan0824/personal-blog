{ "out": "mysql-ha-lab-12", "shots": [
 { "name": "01-version", "title": "db1 — Percona Server 8.4.11 與 XtraBackup 8.4.0-7", "log": "12-xtrabackup-pitr.log", "from": "[db1]# mysqld --version; xtrabackup", "lines": 4 },
 { "name": "02-full", "title": "全量備份（線上、不鎖表，app 持續寫入）", "log": "12-xtrabackup-pitr.log", "from": "[db1]# mkdir -p /backup; time xtrabackup", "to": "75M\t/backup/full", "skip": ["user\t", "sys\t"], "hl": ["Using server version 8.4.11-12", "completed OK!", "mysql-bin.000003\t198"] },
 { "name": "03-incremental", "title": "增量備份 inc1、inc2", "log": "12-xtrabackup-pitr.log", "from": "--target-dir=/backup/inc1 --incremental-basedir", "to": "mysql-bin.000005\t198", "skip": ["user\t", "sys\t", "[db1]# sleep"], "hl": ["== inc1: 4.1M", "== inc2: 5.2M"] },
 { "name": "04-drop", "title": "事故：誤刪 appdb.t_orders，從 binlog 找出 DROP 的 GTID", "log": "12-xtrabackup-pitr.log", "after": "步驟 4", "from": "[db1] mysql> SELECT COUNT(*) AS rows_before_drop", "to": "DROP TABLE `appdb`.`t_orders`", "hl": ["|             5190 |", "e1080b64-e4ee-11f1-bbc2-22f8774ce1b6:202"] },
 { "name": "05-prepare", "title": "db2 — prepare：全量 → inc1 → inc2（最後一次才 rollback）", "log": "12-xtrabackup-pitr.log", "after": "步驟 6", "from": "[db2]# time xtrabackup --prepare --apply-log-only --target-dir=/backup/full 2>&1", "to": "mysql-bin.000005\t198", "skip": ["user\t", "sys\t", "Starting to parse redo", "Starting crash recovery"], "hl": ["--apply-log-only", "full-prepared"] },
 { "name": "06-copy-back", "title": "db2 — copy-back 並啟動：資料停在備份當下", "log": "12-xtrabackup-pitr.log", "after": "步驟 7", "from": "[db2]# systemctl stop mysqld", "to": "|           5144 |", "skip": ["user\t", "sys\t"], "hl": ["1-155", "5144"] },
 { "name": "07-pitr", "title": "PITR：從備份的 binlog 位置重放，--exclude-gtids 排除 DROP", "log": "12-xtrabackup-pitr.log", "after": "步驟 8", "from": "[db2]# cat /backup/full/xtrabackup_binlog_info", "to": "1-201:203-204", "hl": ["--exclude-gtids='e1080b64-e4ee-11f1-bbc2-22f8774ce1b6:202'", "|            5190 |", "1-201:203-204"] },
 { "name": "08-final", "title": "比對：PITR 後 5190 筆，app 回報成功的 190 筆全部都在", "log": "12-xtrabackup-pitr.log", "after": "比對", "from": "[db2] mysql> SELECT COUNT(*) AS rows_cnt", "to": "|         190 |", "hl": ["5190", "190"] }
]}
