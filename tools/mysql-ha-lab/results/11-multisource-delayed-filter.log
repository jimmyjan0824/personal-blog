======== 坑 2：REPLICATE_IGNORE_DB 對 DDL（statement 格式）看的是「預設資料庫」，CREATE TABLE tmp_report.daily 沒被擋 ========  (2026-11-20 14:39:18)
[db2]# mysqlbinlog --no-defaults $(ls /var/lib/mysql/mysql-bin.0* | tail -1) | grep -E '^(use|CREATE|INSERT)|GTID_NEXT=' | grep -B1 -E 'tmp_report' | head -8
SET @@SESSION.GTID_NEXT= '1de44f85-e4f0-11f1-9d02-3aa3db226f89:7'/*!*/;
CREATE DATABASE tmp_report
SET @@SESSION.GTID_NEXT= '1de44f85-e4f0-11f1-9d02-3aa3db226f89:8'/*!*/;
CREATE TABLE tmp_report.daily (d DATE PRIMARY KEY, total INT)


======== 解法：改用 REPLICATE_WILD_IGNORE_TABLE（依實際的庫名.表名判斷），那筆交易就會被過濾，不需要跳過 ========  (2026-11-20 14:39:18)
[db3] mysql> STOP REPLICA FOR CHANNEL 'ch_inv';
CHANGE REPLICATION FILTER REPLICATE_IGNORE_DB = (), REPLICATE_WILD_IGNORE_TABLE = ('tmp_report.%') FOR CHANNEL 'ch_inv';
START REPLICA FOR CHANNEL 'ch_inv';

[db3]# sleep 2

